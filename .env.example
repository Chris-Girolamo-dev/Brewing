# Copy to .env.local. Without these the app runs in demo mode (browser-local storage, seeded).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Enables Recipes → “Import from photo” (Claude reads a photo/PDF of a recipe page).
# Optional. Without it the import button shows a “not configured” message.
ANTHROPIC_API_KEY=
